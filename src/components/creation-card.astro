---
import type { CollectionEntry } from "astro:content";
import Arrow from "@/components/arrow.astro";

interface Props {
  creation: CollectionEntry<"creations">;
}

const { creation } = Astro.props;
const hasCta = Boolean(creation.data.ctaLabel && creation.data.ctaHref);
---

<li class="creation-item">
  <a class="creation-link" href={`/creations/${creation.id}`}>
    <h2>
      {creation.data.title}
      <Arrow />
    </h2>
    <p>{creation.data.blurb}</p>
  </a>

  {hasCta && (
    <a class="text-link cta-link creation-cta" href={creation.data.ctaHref}>
      {creation.data.ctaLabel}
      <Arrow />
    </a>
  )}
</li>

<style>
  .creation-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-block: 30px;
    border-bottom: 1px solid var(--rule);
  }

  .creation-link {
    display: block;
    flex: 1;
    min-width: 0;
  }

  .creation-link h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 500;
  }

  .creation-link h2 :global(.arrow) {
    width: 20px;
    color: var(--green);
    transition: transform 180ms ease;
  }

  .creation-link p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.45;
  }

  .creation-link:hover h2,
  .creation-link:focus-visible h2 {
    color: var(--green);
  }

  .creation-link:hover h2 :global(.arrow),
  .creation-link:focus-visible h2 :global(.arrow) {
    transform: translateX(4px);
  }

  .creation-cta {
    flex: none;
    margin-top: 5px;
    font-size: 16px;
  }

  @media (max-width: 700px) {
    .creation-item {
      display: block;
      padding-block: 26px;
    }

    .creation-cta {
      margin-top: 16px;
    }
  }
</style>
