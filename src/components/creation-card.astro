---
import type { CollectionEntry } from "astro:content";

interface Props {
  creation: CollectionEntry<"creations">;
}

const { creation } = Astro.props;
---

<li id={creation.id} class="rounded-2xl border p-5">
  <h2 class="text-xl font-semibold">{creation.data.title}</h2>
  <p class="mt-2 text-slate-700">{creation.data.blurb}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {
      creation.data.tags.map((tag: string) => (
        <span class="text-xs rounded-full border px-2 py-1">{tag}</span>
      ))
    }
  </div>
  <div class="mt-4 flex gap-3">
    <a
      href={`/creations/${creation.id}`}
      class="inline-block px-4 py-2 rounded-lg border border-slate-300 hover:border-slate-400 transition-colors"
    >
      View Details
    </a>
    <a
      href={creation.data.ctaHref}
      class="inline-block px-4 py-2 rounded-lg bg-black text-white hover:bg-slate-800 transition-colors"
    >
      {creation.data.ctaLabel}
    </a>
  </div>
</li>
