---
import "@/styles/global.css";
import { Image } from "astro:assets";
import logo from "@/images/NLC-logo.svg";

const {
  title = "NewLad Creations",
  description = "Novel Engineering: Wisdom, Life & Dreams",
} = Astro.props;
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="h-full flex flex-col bg-white text-slate-900">
    <header class="border-b">
      <nav class="mx-auto max-w-5xl flex items-center justify-between p-4">
        <div class="flex items-center gap-2">
          <Image src={logo} alt="NewLad Creations" width={32} height={32} />
          <a href="/" class="font-semibold hidden sm:block">NewLad Creations</a>
        </div>
        <ul class="flex gap-4">
          <li><a href="/" class="hover:underline">Home</a></li>
          <li><a href="/creations" class="hover:underline">Creations</a></li>
        </ul>
      </nav>
    </header>

    <main class="flex-1 mx-auto max-w-5xl p-6">
      <slot />
    </main>

    <footer class="mt-12 border-t">
      <div class="mx-auto max-w-5xl p-4 text-sm text-slate-600">
        © {new Date().getFullYear()} NewLad Creations — Think. Build. Reflect.
      </div>
    </footer>
  </body>
</html>
