---
import BaseLayout from "@/layouts/base-layout";
import Arrow from "@/components/arrow";
import { notes } from "@/data/notes";
---

<BaseLayout
  title="Notes — NewLad Creations"
  description="Ideas and lessons as they take shape."
>
  <section class="notes-index" aria-labelledby="notes-title">
    <header class="notes-heading">
      <h1 id="notes-title">Notes</h1>
      <p>Ideas and lessons as they take shape.</p>
    </header>

    <ul class="notes-list">
      {notes.map((note) => (
        <li class="note-item">
          <a class="note-link" href={note.href}>
            <div class="note-copy">
              <h2>{note.title}</h2>
              <p>{note.summary}</p>
            </div>
            <Arrow />
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .notes-index {
    max-width: 920px;
    margin-inline: auto;
  }

  .notes-heading {
    max-width: 620px;
    padding-bottom: 52px;
  }

  .notes-heading h1 {
    font-size: clamp(42px, 5.4vw, 72px);
    font-weight: 600;
  }

  .notes-heading p {
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(20px, 2.1vw, 26px);
    line-height: 1.4;
  }

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .note-item {
    border-bottom: 1px solid var(--rule);
  }

  .note-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    min-height: 44px;
    padding-block: 30px;
  }

  .note-copy {
    min-width: 0;
  }

  .note-copy h2 {
    color: var(--ink);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 500;
    line-height: 1.1;
  }

  .note-copy p {
    max-width: 60ch;
    margin-top: 10px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.45;
  }

  .note-link :global(.arrow) {
    width: 22px;
    margin-top: 5px;
    color: var(--green);
  }

  .note-link:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .note-link:hover :global(.arrow) {
      transform: translateX(4px);
    }
  }

  @media (max-width: 700px) {
    .notes-heading {
      padding-bottom: 36px;
    }

    .note-link {
      gap: 16px;
      padding-block: 26px;
    }

    .note-copy h2 {
      font-size: 26px;
      line-height: 1.12;
    }

    .note-copy p {
      font-size: 19px;
      line-height: 1.45;
    }
  }
</style>
