---
import BaseLayout from "@/layouts/base-layout"

const items = [
  {
    id: "adhd-task-planner",
    title: "ADHD Task Planner (Printable PDF)",
    blurb: "Minimal, generous notes area, inline labels/inputs.",
    ctaLabel: "Get PDF",
    ctaHref: "#", // replace with Etsy/Notion link
    tags: ["PDF", "Planner"]
  },
  {
    id: "notion-work-planner",
    title: "Notion Work Planner",
    blurb: "Streamlined database + views for focus & delivery.",
    ctaLabel: "Duplicate in Notion",
    ctaHref: "#", // replace with Notion template link
    tags: ["Notion", "Template"]
  }
];
---
<BaseLayout title="NewLad — Creations">
    <h1 class="text-3xl font-bold mb-6">Creations</h1>
    <ul class="grid gap-6 md:grid-cols-2">
      {items.map((it) => (
              <li id={it.id} class="rounded-2xl border p-5">
                  <h2 class="text-xl font-semibold">{it.title}</h2>
                  <p class="mt-2 text-slate-700">{it.blurb}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {it.tags.map((t) => <span class="text-xs rounded-full border px-2 py-1">{t}</span>)}
                  </div>
                  <div class="mt-4">
                      <a href={it.ctaHref} class="inline-block px-4 py-2 rounded-lg bg-black text-white">{it.ctaLabel}</a>
                  </div>
              </li>
      ))}
    </ul>
</BaseLayout>
