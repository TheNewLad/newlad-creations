---
import { getCollection, render } from "astro:content";
import Arrow from "@/components/arrow.astro";
import BaseLayout from "../../layouts/base-layout.astro";

export async function getStaticPaths() {
  const creations = await getCollection("creations", ({ data }) => {
    return data.draft !== true;
  });

  return creations.map((creation) => ({
    params: { slug: creation.id },
    props: { creation },
  }));
}

const { creation } = Astro.props;
const { Content } = await render(creation);
const hasCta = Boolean(creation.data.ctaLabel && creation.data.ctaHref);
---

<BaseLayout
  title={`${creation.data.title} — NewLad Creations`}
  description={creation.data.blurb}
>
  <article class="reading">
    <a class="text-link back-link" href="/creations">
      <span class="back-arrow"><Arrow /></span>
      Back to creations
    </a>

    <header>
      <h1>{creation.data.title}</h1>
      <p class="description">{creation.data.blurb}</p>
      <ul class="tag-list" aria-label="Topics">
        {creation.data.tags.map((tag: string) => <li>{tag}</li>)}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>

    {hasCta && (
      <footer class="reading-footer">
        <a class="text-link cta-link" href={creation.data.ctaHref}>
          {creation.data.ctaLabel}
          <Arrow />
        </a>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .back-link {
    margin-bottom: 8px;
  }

  .back-arrow {
    display: inline-flex;
    transform: rotate(180deg);
  }

  .back-arrow :global(.arrow) {
    width: 18px;
  }
</style>
