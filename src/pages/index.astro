---
import BaseLayout from "@/layouts/base-layout";
---
<BaseLayout title="NewLad Creations — Home">
    <section class="grid gap-6 md:grid-cols-2 items-center">
        <div class="space-y-4">
            <h1 class="text-3xl md:text-5xl font-bold leading-tight">
                Tools & templates that help ADHD-minds ship.
            </h1>
            <p class="text-lg text-slate-700">
                I build simple, low-friction systems for focus: Notion templates, PDFs, and small web tools.
            </p>
            <div class="flex gap-3">
                <a href="/creations" class="px-4 py-2 rounded-lg bg-black text-white">Browse Creations</a>
                <a href="#about" class="px-4 py-2 rounded-lg border">Learn more</a>
            </div>
        </div>
        <div class="rounded-2xl border p-6">
            <p class="font-medium mb-2">Featured: ADHD Task Planner (Printable PDF)</p>
            <ul class="list-disc pl-5 text-slate-700">
                <li>Inline Task & Dates</li>
                <li>Big Notes area</li>
                <li>Clean, low-clutter layout</li>
            </ul>
            <a href="/creations#adhd-task-planner" class="mt-4 inline-block underline">See details →</a>
        </div>
    </section>

    <section id="about" class="mt-12 space-y-3">
        <h2 class="text-2xl font-semibold">About</h2>
        <p class="text-slate-700">
            NEWLAD = Novel Engineering: Wisdom, Life, and Dreams. I make practical tools for real people.
        </p>
    </section>
</BaseLayout>
