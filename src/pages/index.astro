---
import BaseLayout from "@/layouts/base-layout.astro";
import Arrow from "@/components/arrow.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/plates/portrait.png";
import homeArt from "../../assets/plates/home-art.png";
import driftArt from "../../assets/plates/drift-art.png";
import loveArt from "../../assets/plates/love-art.png";
import { notes } from "@/data/notes";
---
<BaseLayout home title="NewLad Creations — Hi, I’m Karim.">
  <section class="introduction" aria-labelledby="intro-title">
    <div class="intro-copy">
      <h1 id="intro-title"><span>Hi, I’m Karim.</span><span class="second-line">I like making things.</span></h1>
      <svg class="intro-underline" viewBox="0 0 145 12" width="145" height="12" fill="none" aria-hidden="true"><path d="M2 8Q71 1 142 5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
      <p class="intro-lead">Software, automations, experiments,<br class="desktop-break" /> and the occasional detour.</p>
      <p class="intro-description">I share what I’m building and<br class="desktop-break" /> what I’m figuring out along the way.</p>
      <a class="text-link cta-link explore-link" href="#creations">Explore the creations <Arrow /></a>
    </div>
    <div class="portrait-frame"><Image src={portrait} alt="Karim smiling, wearing a black shirt." width={1116} widths={[640, 960, 1116, 1600]} sizes="(max-width: 700px) 596px, (max-width: 1100px) 870px, 1116px" loading="eager" fetchpriority="high" quality={85} /></div>
  </section>

  <section id="creations" class="creations-strip" aria-label="Selected creations">
    <article class="project project-home">
      <Image class="project-art" src={homeArt} width={408} widths={[220,408,612]} sizes="(max-width: 700px) 130px, 204px" alt="" loading="eager" />
      <div class="project-copy"><h2><a class="project-link" href="/creations/home-automation">Home automation<span class="project-arrow"><Arrow /></span></a></h2><p>Systems I built for my home.</p><span class="concept-caption home-caption">Concept artwork</span></div>
    </article>
    <article class="project project-drift">
      <figure class="project-figure"><div class="drift-diagram"><Image class="project-art" src={driftArt} width={378} widths={[220,378,568]} sizes="(max-width: 700px) 130px, 189px" alt="" loading="eager" /><span class="word word-rain">Rain</span><span class="word word-window">Window</span><span class="word word-thought">Your first<br />thought</span></div><figcaption class="concept-caption">Game concept</figcaption></figure>
      <div class="project-copy"><h2><a class="project-link" href="/creations/project-drift">Project Drift<span class="project-arrow"><Arrow /></span></a></h2><p>A word-association game<br class="desktop-break" /> I’m testing.</p><span class="handwritten">Testing</span></div>
    </article>
    <article class="project project-love">
      <figure class="project-figure"><Image class="project-art" src={loveArt} width={428} widths={[240,428,642]} sizes="(max-width: 700px) 140px, 214px" alt="" loading="eager" /><figcaption class="concept-caption">Concept artwork</figcaption></figure>
      <div class="project-copy"><h2><a class="project-link" href="/creations/fell-for-love">Fell for Love<span class="project-arrow"><Arrow /></span></a></h2><p>A wedding tool I built.<br />The story so far.</p><span class="handwritten">The story so far</span></div>
    </article>
  </section>

  <section id="notes" class="notes-strip" aria-labelledby="notes-title">
    <div class="notes-intro"><h2 id="notes-title">Notes along the way</h2><p>I’m sharing ideas and lessons<br class="desktop-break" /> as they take shape.</p></div>
    {notes.map(note => <article class="note"><h3><a href={note.href}>{note.title}</a></h3><p>{note.summary}</p><a class="note-more" href={note.href}>Read the note<span class="sr-only">: {note.title}</span></a></article>)}
  </section>
  <a class="text-link all-notes" href="/notes">All notes <Arrow /></a>

  <section id="about" class="about-section" aria-labelledby="about-title">
    <div class="about-heading"><h2 id="about-title">A little more about me.</h2><span class="handwritten">Usually making something.</span></div>
    <div class="about-copy">
      <p>I’m Karim, a software engineer who started writing code in a Java class in 2011. I grew up in New Jersey, moved to Texas after college, and have been here ever since.</p>
      <p>I like solving problems and making things: frontend development, home automations, 3D printing, woodworking. I’ve made videos and podcasts, too. My interests take a few turns.</p>
      <p>NewLad Creations is my place to share all of it, including the experiments that are still figuring themselves out. The name is a little piece of my own: NEW from Newell, and DAL from Dallas, flipped around.</p>
      <p>I’m exploring what working for myself could look like. Mostly, I want to keep creating, meet people who are curious about the same things, and learn from people who know things I don’t.</p>
      <a class="text-link" href="/creations">More of what I’ve made <Arrow /></a>
    </div>
  </section>
  <section id="say-hello" class="contact-section" aria-labelledby="contact-title">
    <h2 id="contact-title">Got an idea? I’m listening.</h2>
    <p>A shared interest, something you’re building, or a thought you want to talk through. I’d like to hear it.</p>
    <a class="text-link cta-link" href="mailto:karim@newladcreations.com">karim@newladcreations.com <Arrow /></a>
  </section>
</BaseLayout>
<style>
.introduction{display:grid;grid-template-columns:1fr 1fr;min-height:508px;padding-top:28px;align-items:start}.intro-copy{padding-top:39px}.intro-copy h1{font-size:70px;font-weight:700;line-height:1.04;letter-spacing:-.025em}.intro-copy h1 span{display:block}.intro-copy h1 .second-line{font-size:60px;line-height:1.12;white-space:nowrap}.intro-underline{display:block;color:var(--green);margin-top:22px}.intro-lead{font-size:24px;line-height:32px;margin-top:28px}.intro-description{font-size:22px;line-height:31px;margin-top:16px}.explore-link{font-size:20px;margin-top:20px;letter-spacing:-.01em;gap:8px}.explore-link :global(.arrow){width:18px}.portrait-frame{position:relative;width:min(450px,29.296875vw);aspect-ratio:1;overflow:hidden;border-radius:50%;justify-self:center;margin-right:32px}.portrait-frame img{position:absolute;max-width:none;width:248.0625%;height:auto;left:-68.75%;top:-5%}
.creations-strip{display:grid;grid-template-columns:36.5% 31.2% 32.3%;margin-top:42px;scroll-margin-top:32px}.project{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:24px;min-height:192px;align-items:start;padding:0 32px;border-right:1px solid var(--rule)}.project:first-child{padding-left:0;grid-template-columns:40% 1fr;gap:70px}.project:last-child{padding-right:0;border-right:0;gap:28px;grid-template-columns:52% 1fr}.project-drift{grid-template-columns:47% 1fr;gap:20px;padding-right:12px}.project-art{width:100%;height:168px;object-fit:fill;display:block}.project-home .project-art{height:151px;object-fit:contain;margin-top:14px;width:184px;max-width:100%;margin-left:4px}.project-figure{min-width:0;margin:0}.project-copy{min-width:0;padding-top:5px}.project h2{font-size:30px;line-height:1.1;font-weight:400;letter-spacing:-.025em;white-space:nowrap}.project-copy p{font-size:17px;line-height:26px;margin-top:14px}.project-link::after{content:'';position:absolute;inset:0;z-index:1}.project-link:hover{color:var(--green)}.project:has(.project-link:focus-visible){outline:2px solid var(--green);outline-offset:8px}.project-link:focus-visible{outline:none}.project-arrow{position:absolute;right:32px;bottom:21px;color:var(--green)}.project:last-child .project-arrow{right:0}.concept-caption{display:block;font-size:14px;line-height:20px;font-style:italic;color:var(--muted);margin-top:8px}.home-caption{position:absolute;bottom:16px}.handwritten{display:inline-block;position:relative;font-family:var(--font-note);font-size:25px;line-height:1.2;color:var(--green);margin-top:16px;white-space:nowrap}.handwritten::after{content:'';position:absolute;height:1px;background:var(--green);left:0;right:8%;bottom:-5px;transform:rotate(-3deg)}.drift-diagram{position:relative}.drift-diagram .project-art{height:165px}.word{position:absolute;font-size:18px;line-height:1.15;text-align:center;transform:translate(-50%,-50%);pointer-events:none}.word-rain{left:27%;top:27%}.word-window{left:74%;top:27%}.word-thought{left:50%;top:76%}.project-love .project-art{height:165px}
.notes-strip{display:grid;grid-template-columns:28.85% 22.65% 25.85% 22.65%;border-top:1px solid var(--rule);margin-top:30px;padding-top:32px;scroll-margin-top:32px}.notes-intro{margin-top:-8px}.notes-intro h2{font-size:36px;font-weight:400;line-height:1.2;white-space:nowrap}.notes-intro p{font-size:18px;line-height:26px;margin-top:8px}.note{min-width:0;padding:2px 32px 0;border-right:1px solid var(--rule)}.note:nth-child(3){padding-left:57px}.note:last-child{padding-right:0;padding-left:50px;border:0}.note h3{font-size:18px;line-height:25px;letter-spacing:0;font-weight:400;color:var(--green)}.note h3 a:hover{text-decoration:underline}.note p{font-size:17px;line-height:25px;max-width:27ch;margin-top:12px}.note-more{display:inline-block;font-size:14px;font-style:italic;color:var(--muted);margin-top:8px;min-height:24px}.note-more:hover{color:var(--green);text-decoration:underline}

.about-section{display:grid;grid-template-columns:38% 1fr;gap:48px;border-top:1px solid var(--rule);padding-top:64px;margin-top:88px;scroll-margin-top:32px}.about-heading h2{font-size:42px;font-weight:500;max-width:12ch}.about-heading .handwritten{font-size:28px;margin-top:24px}.about-copy{max-width:64ch;font-size:21px;line-height:1.65}.about-copy p+p{margin-top:20px}.about-copy .text-link{font-size:19px;margin-top:24px}.contact-section{padding-top:56px;margin-top:64px;border-top:1px solid var(--rule);max-width:760px}.contact-section h2{font-size:38px;font-weight:500}.contact-section p{max-width:50ch;font-size:20px;line-height:1.65;margin-top:18px}.contact-section .text-link{font-size:22px;margin-top:20px}

@keyframes underline-in{from{stroke-dashoffset:150}to{stroke-dashoffset:0}}
.intro-underline path{stroke-dasharray:150;animation:underline-in 700ms cubic-bezier(.16,1,.3,1) both}
@media(prefers-reduced-motion:reduce){.intro-underline path{animation:none;stroke-dasharray:none}}

@media(min-width:1280px) and (max-width:1535px){
.introduction{min-height:33.072917vw;padding-top:1.822917vw}.intro-copy{padding-top:2.539063vw}.intro-copy h1{font-size:4.557292vw}.intro-copy h1 .second-line{font-size:3.90625vw}.intro-underline{margin-top:1.432292vw;width:9.440104vw;height:.78125vw}.intro-lead{font-size:max(20px,1.5625vw);line-height:max(28px,2.083333vw);margin-top:1.822917vw}.intro-description{font-size:max(18px,1.432292vw);line-height:max(27px,2.018229vw);margin-top:1.041667vw}.explore-link{font-size:max(18px,1.302083vw);margin-top:1.302083vw}.creations-strip{margin-top:2.734375vw}.project{min-height:192px;padding-bottom:44px;padding-inline:2.083333vw;gap:1.5625vw}.project:first-child{gap:4.557292vw}.project:last-child{gap:1.822917vw}.project-drift{gap:1.302083vw;padding-right:.78125vw}.project h2{font-size:1.953125vw}.project-copy p{font-size:max(16px,1.106771vw);line-height:max(24px,1.692708vw);margin-top:.911458vw}.project-art{height:10.9375vw}.project-home .project-art{height:9.830729vw;width:11.979167vw;margin-top:.911458vw}.drift-diagram .project-art,.project-love .project-art{height:10.742188vw}.word{font-size:1.171875vw}.handwritten{font-size:1.627604vw;margin-top:1.041667vw}.project-arrow{right:2.083333vw;bottom:1.367188vw}.concept-caption{font-size:max(12px,.911458vw)}.notes-strip{margin-top:1.953125vw;padding-top:2.083333vw}.notes-intro h2{font-size:2.34375vw}.notes-intro p{font-size:max(16px,1.171875vw);line-height:max(24px,1.692708vw)}.note{padding-inline:2.083333vw}.note:nth-child(3){padding-left:3.710938vw}.note:last-child{padding-left:3.255208vw}.note h3{font-size:max(16px,1.171875vw);line-height:max(24px,1.627604vw)}.note p{font-size:max(16px,1.106771vw);line-height:max(24px,1.627604vw)}.note-more{font-size:14px}.project-copy .desktop-break{display:none}
}
@media(min-width:701px) and (max-width:1279px){
.introduction{min-height:420px;padding-top:32px;gap:20px;grid-template-columns:55% 45%}.intro-copy{padding-top:16px}.intro-copy h1{font-size:clamp(42px,5.4vw,58px)}.intro-copy h1 .second-line{font-size:clamp(32px,4.4vw,48px);white-space:normal;max-width:14ch}.portrait-frame{width:90%;max-width:330px;margin:16px 0 0}.intro-lead{font-size:20px;line-height:28px;margin-top:24px}.intro-description{font-size:19px;line-height:27px}.explore-link{font-size:18px}.desktop-break{display:none}.creations-strip{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:40px}.project,.project:first-child,.project:last-child{display:flex;flex-direction:column;gap:18px;padding:0 24px 34px;min-height:350px}.project:first-child{padding-left:0}.project:last-child{padding-right:0}.project-art,.project-home .project-art,.project-love .project-art,.drift-diagram .project-art{width:100%;max-width:200px;height:160px;object-fit:contain;margin:0}.project-figure{width:100%;max-width:200px}.project-copy{padding-top:0}.project h2{font-size:26px;white-space:normal}.project-copy p{font-size:17px;line-height:25px}.project-arrow{right:20px;bottom:4px}.home-caption{bottom:4px}.concept-caption{font-size:13px;margin-top:6px}.handwritten{font-size:25px}.notes-strip{grid-template-columns:1fr 1fr;gap:28px 0;margin-top:36px}.notes-intro{grid-column:1/-1;margin:0}.notes-intro h2{font-size:34px}.notes-intro p{max-width:45ch}.note,.note:nth-child(3),.note:last-child{padding:0 24px 0 0;border:0}.note h3{font-size:19px;white-space:normal}.note p{font-size:17px}.note-more{min-height:36px}.about-section{grid-template-columns:1fr;gap:28px;padding-top:40px;margin-top:56px}.about-heading h2{font-size:36px;max-width:none}.about-heading .handwritten{margin-top:12px}.about-copy{font-size:20px}.contact-section h2{font-size:34px}
}
@media(max-width:700px){
.introduction{display:flex;flex-direction:column;min-height:0;padding-top:28px}.intro-copy{padding:0;width:100%}.intro-copy h1{font-size:clamp(38px,10.7vw,52px);line-height:1.08;letter-spacing:-.025em}.intro-copy h1 .second-line{font-size:clamp(31px,8.65vw,43px);line-height:1.13;white-space:normal;max-width:17ch;text-wrap:balance}.intro-underline{margin-top:14px;width:118px}.intro-lead{font-size:18px;line-height:26px;margin-top:24px;max-width:34ch}.intro-description{font-size:18px;line-height:26px;margin-top:12px;max-width:35ch}.desktop-break{display:none}.explore-link{font-size:18px;margin-top:16px}.portrait-frame{width:208px;max-width:62vw;margin:24px auto 0;align-self:center}.creations-strip{grid-template-columns:1fr;margin-top:40px}.project,.project:first-child,.project:last-child{grid-template-columns:128px minmax(0,1fr);gap:20px;padding:24px 0;min-height:194px;border:0;border-bottom:1px solid var(--rule)}.project:first-child{padding-top:0;min-height:170px}.project:last-child{border-bottom:0}.project-art,.project-home .project-art,.project-love .project-art,.drift-diagram .project-art{width:128px;height:128px;object-fit:contain;margin:0}.project-copy{padding-top:4px}.project h2{font-size:24px;white-space:normal;line-height:1.12}.project-copy p{font-size:16px;line-height:23px;margin-top:10px}.project-arrow{right:0;bottom:23px}.home-caption{position:static;margin-top:20px}.concept-caption{font-size:12px;line-height:17px;margin-top:4px}.home-caption{margin-top:18px}.handwritten{font-size:23px;margin-top:12px}.word{font-size:12px}.word-rain,.word-window{top:28%}.word-thought{top:76%}.notes-strip{display:block;margin-top:20px;padding-top:28px}.notes-intro{margin:0 0 22px}.notes-intro h2{font-size:30px;white-space:normal}.notes-intro p{font-size:17px;line-height:25px;max-width:32ch;margin-top:10px}.note,.note:nth-child(3),.note:last-child{border:0;border-top:1px solid var(--rule);padding:20px 0 8px}.note h3{font-size:20px;line-height:1.3;white-space:normal}.note p{font-size:17px;line-height:25px;max-width:38ch;margin-top:10px}.note-more{font-size:14px;min-height:44px;display:inline-flex;align-items:center;margin-top:2px}.about-section{grid-template-columns:1fr;gap:24px;margin-top:40px;padding-top:36px}.about-heading h2{font-size:34px;max-width:14ch}.about-heading .handwritten{font-size:25px;margin-top:16px}.about-copy{font-size:18px;line-height:1.7}.about-copy p+p{margin-top:18px}.about-copy .text-link{font-size:18px;margin-top:16px}.contact-section{padding-top:32px;margin-top:40px}.contact-section h2{font-size:32px;max-width:15ch}.contact-section p{font-size:18px;line-height:1.65;margin-top:16px}.contact-section .text-link{font-size:clamp(17px,5.1vw,21px);max-width:100%;overflow-wrap:anywhere;gap:6px}
}
@media(max-width:360px){.project,.project:first-child,.project:last-child{grid-template-columns:105px minmax(0,1fr);gap:16px}.project-art,.project-home .project-art,.project-love .project-art,.drift-diagram .project-art{width:105px;height:115px}.project h2{font-size:22px}.word{font-size:11px}.notes-intro h2{font-size:28px}}

.all-notes{margin-top:20px;font-size:18px}
@media(pointer:coarse){
  .note h3 a{display:inline-flex;align-items:center;min-height:44px}
  .note-more{display:inline-flex;align-items:center;min-height:44px;font-size:16px}
}
</style>
